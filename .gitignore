# --- Node / API ---
node_modules/
dist/
coverage/
*.log
.env
.env.*
!.env.example
.pnpm-store/

# --- Flutter / Dart / mobile ---
apps/flutter/.dart_tool/
apps/flutter/.packages
apps/flutter/build/
apps/flutter/.flutter-plugins
apps/flutter/.flutter-plugins-dependencies
apps/flutter/ios/Pods/
apps/flutter/ios/.symlinks/
apps/flutter/ios/Flutter/ephemeral/
apps/flutter/android/.gradle/
apps/flutter/android/local.properties
apps/flutter/android/key.properties
apps/flutter/**/*.jks
apps/flutter/**/*.keystore

# The Firebase client config is NOT ignored — see docs/decisions/002. It ships
# inside every binary, so keeping it out of git hides it from review without
# hiding it from anyone who installs the app, and breaks a fresh clone.

# --- Native iOS (apps/ios) ---
apps/ios/**/xcuserdata/
apps/ios/**/*.xcuserstate
apps/ios/DerivedData/
apps/ios/build/
apps/ios/Packages/**/.build/
apps/ios/Packages/**/.swiftpm/
# Package.resolved IS committed: it pins exact dependency versions for the app.

# --- Editors / OS ---
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db

# --- Claude Code local settings ---
.claude/settings.local.json
