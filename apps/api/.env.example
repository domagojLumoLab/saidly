# Copy to .env and fill in. Never commit .env.
# An empty value (KEY=) is treated as "not set" and the default below applies.

# development | test | production (default: development)
NODE_ENV=
# fatal | error | warn | info | debug | trace | silent (default: info)
LOG_LEVEL=
# default: 3000
PORT=
DATABASE_URL=
# Read straight from the environment by test/setup/database.ts, not through
# config.ts — tests cannot call loadConfig, which would demand DATABASE_URL and
# FIREBASE_PROJECT_ID that a test run has no reason to set.
# default: postgres://saidly:saidly@localhost:5432/saidly_test
TEST_DATABASE_URL=
FIREBASE_PROJECT_ID=
# Leave empty outside production: no DSN means nothing is reported.
SENTRY_DSN=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
