# Copy to .env and fill in. Never commit .env.
# An empty value (KEY=) is treated as "not set" and the default below applies.

# development | test | production (default: development)
NODE_ENV=
# fatal | error | warn | info | debug | trace | silent (default: info)
LOG_LEVEL=
# default: 3000
PORT=
DATABASE_URL=
# Used only by `pnpm test`. Defaults to the Docker Postgres below, on its own
# database, so tests never touch development data.
# default: postgres://saidly:saidly@localhost:5432/saidly_test
TEST_DATABASE_URL=
FIREBASE_PROJECT_ID=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
